{
  "name": "dragonfly-wp-theme",
  "private": true,
  "description": "Build tooling for the Dragonfly Investments WordPress theme (wp-theme/dragonfly)",
  "scripts": {
    "dev": "tailwindcss -i ./src/tailwind.css -o ./dragonfly/assets/css/main.css --watch",
    "build": "tailwindcss -i ./src/tailwind.css -o ./dragonfly/assets/css/main.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4"
  }
}
